# Copy this file to .env and fill in your real API keys.
# cp .env.example .env

# LLM — used by search, reader, writer, and critic agents
# Option A: DeepSeek direct
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Option B: DeepSeek via OpenRouter
DEEPSEEK_API_KEY=your-openrouter-api-key
DEEPSEEK_MODEL=deepseek/deepseek-chat
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# Tavily — used by the web_search tool
TAVILY_API_KEY=your-tavily-api-key
